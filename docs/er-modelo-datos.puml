@startuml Modelo Entidad-Relacion - Sistema de Reservas
' ============================================================
' INACAP — Modelo Entidad-RL (DER) — versión industrial
' Sólo entidades persistentes con PK real en PostgreSQL.
' Los stores del navegador (Cache Storage, localStorage) y los
' artefactos QR/.ics NO son entidades de BD: se documentan en
' el diagrama de despliegue y en el documento técnico (cap. 3).
' Prefijos: DBI. = DB-Institucional | DBR. = DB-Reservas
' ============================================================

skinparam defaultFontName Arial
skinparam roundCorner 4
skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 70
skinparam ranksep 65
skinparam entity {
  BackgroundColor #FFFFFF
  BorderColor #2B7A9E
  FontColor #1F2937
  FontSize 10
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #F0B429
  FontSize 9
}

entity "DBI.usuarios_institucion" as USUARIO {
  * id : uuid <<PK>>
  * rut : varchar(12) <<UK>>
  primer_nombre : varchar
  segundo_nombre : varchar
  apellido_paterno : varchar
  apellido_materno : varchar
  nombre_completo : text <<GENERATED>>
  correo_institucional : varchar(150) <<UK>>
  password_hash : text
  rol : varchar(30)
  carrera_o_departamento : varchar
  estado_activo : boolean
  creado_en : timestamptz
}

entity "DBR.tipos_sala" as TIPO {
  * id : text <<PK>>
  nombre : text <<UK>>
  prefijo : text <<UK>>
  aforo_sugerido : integer
  color : text
  orden : integer
  creado_en : timestamptz
}

entity "DBR.salas" as SALA {
  * id_sala : varchar(20) <<PK>>
  nombre_descriptivo : varchar <<UK>>
  tipo : text <<FK>>
  aforo : integer
  piso : integer
  estado_habilitacion : varchar
  qr_token : uuid <<UK>>
  codigo_manual : varchar(6) <<UK>>
  creado_en : timestamptz
}

entity "DBR.reservas" as RESERVA {
  * id_reserva : uuid <<PK>>
  codigo_reserva : varchar(20) <<UK>>
  id_sala : varchar(20) <<FK>>
  usuario_rut : varchar(12)
  fecha : date
  bloque_horario : integer
  cantidad_asistentes : integer
  proposito : varchar(100)
  estado : varchar
  asistencia_registrada_en : timestamptz
  creado_en : timestamptz
}

entity "DBR.historial_penalizaciones" as PENAL {
  * id : uuid <<PK>>
  usuario_rut : varchar(12)
  ausencias_acumuladas : integer
  bloqueado_hasta : timestamptz
  ultima_actualizacion : timestamptz
}

entity "DBR.bitacora_administrativa" as BITACORA {
  * id : uuid <<PK>>
  encargado_rut : varchar(12)
  accion : text
  rut_estudiante_afectado : varchar(12)
  creado_en : timestamptz
}

entity "DBR.intentos_login" as INTENTOS {
  * clave : varchar <<PK>>
  intentos : integer
  bloqueado_hasta : timestamptz
  actualizado_en : timestamptz
}

' ---- Integridad referencial ----
TIPO    ||--o{ SALA     : "FK salas.tipo → tipos_sala.id\nON UPDATE CASCADE · ON DELETE RESTRICT"
SALA    ||--o{ RESERVA  : "FK reservas.id_sala → salas.id_sala\nON DELETE CASCADE"
USUARIO ||..o{ RESERVA  : "FK lógica por RUT (cross-DB)"
USUARIO ||..o{ PENAL    : "FK lógica por RUT"
USUARIO ||..o{ BITACORA : "FK lógica (encargado y estudiante)"
USUARIO ||..o{ INTENTOS : "relación lógica: clave = SHA-256(IP o cuenta)\nsin FK — no guarda RUT ni correo"

note right of RESERVA
  Índices únicos parciales:
  - (id_sala, fecha, bloque_horario)
    WHERE estado IN ('confirmada','completada')
  - (usuario_rut, fecha, bloque_horario)
    WHERE estado <> 'cancelada'
  Borrado lógico: 'cancelada' (no DELETE).
end note

@enduml
