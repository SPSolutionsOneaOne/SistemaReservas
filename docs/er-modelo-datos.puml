@startuml Modelo Entidad-Relacion - Sistema de Reservas
' ============================================================
' INACAP — Modelo Entidad-Relación (DER) — versión final legible
' 2.1.4.8 integridad referencial (PK/FK/UK)
' 2.1.4.9 estructuradas + no estructuradas con ejemplos
' Prefijos: DBI. = DB-Institucional | DBR. = DB-Reservas | NE. = no estructurado
' ============================================================

skinparam defaultFontName Arial
skinparam roundCorner 4
skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 60
skinparam ranksep 60
skinparam entity {
  BackgroundColor #FFFFFF
  BorderColor #2B7A9E
  FontColor #1F2937
  FontSize 9
}

entity "DBI.usuarios_institucion" as USUARIO {
  * id : uuid <<PK>>
  * rut : varchar(12) <<UK>>
  correo_institucional : varchar(150) <<UK>>
  password_hash : text "Argon2id"
  rol : varchar(30) "alumno|docente|encargado|admin"
  estado_activo : boolean
  nombre_completo : varchar <<GENERATED>>
}

entity "DBR.tipos_sala" as TIPO {
  * id : text <<PK>>
  nombre : text <<UK>>
  prefijo : text <<UK>> "LAB/SAL/AUD/CON/BIB"
  aforo_sugerido : integer
  color : text
  orden : integer
}

entity "DBR.salas" as SALA {
  * id_sala : varchar(20) <<PK>>
  nombre_descriptivo : varchar
  tipo : text <<FK>>
  aforo : integer
  piso : integer
  estado_habilitacion : varchar
  qr_token : uuid <<UK>>
  codigo_manual : varchar(6) <<UK>>
  artefactos : "QR PNG/SVG + .ics (NE.)"
}

entity "DBR.reservas" as RESERVA {
  * id_reserva : uuid <<PK>>
  codigo_reserva : varchar(20) <<UK>>
  id_sala : varchar(20) <<FK>>
  usuario_rut : varchar(12) <<FK lógico>>
  fecha : date
  bloque_horario : integer "0-17"
  cantidad_asistentes : integer
  proposito : varchar(100)
  estado : varchar
  asistencia_registrada_en : timestamptz
  uq1 : "UNIQUE(sala,fecha,bloque) WHERE confirmada/completada"
  uq2 : "UNIQUE(usuario,fecha,bloque) WHERE estado <> cancelada"
}

entity "DBR.historial_penalizaciones" as PENAL {
  * id : uuid <<PK>>
  usuario_rut : varchar(12) <<FK lógico>>
  ausencias_acumuladas : integer "RN05 >= 3"
  bloqueado_hasta : timestamptz "7 días"
}

entity "DBR.bitacora_administrativa" as BITACORA {
  * id : uuid <<PK>>
  encargado_rut : varchar(12) <<FK lógico>>
  accion : text
  rut_estudiante_afectado : varchar(12) <<FK lógico>>
  creado_en : timestamptz
}

entity "DBR.intentos_login" as INTENTOS {
  * clave : text <<PK>> "SHA-256 IP/cuenta"
  intentos : integer "MAX 5"
  bloqueado_hasta : timestamptz "15 min"
}

entity "NE.Cache Storage (Service Worker)" as CACHE {
  * clave : text <<PK>> "Request '/' + assets JS/CSS/PNG"
  valor : Response/Blob "offline-first PWA"
}

entity "NE.localStorage" as LS {
  * clave : text <<PK>> "rs-theme"
  valor : text "light|dark — sin sesión"
}

entity "NE.Artefactos QR / .ics" as ARCHIVOS {
  * nombre : text <<PK>> "QR-LAB-01.png, reserva.ics"
  contenido : blob/text "generado en cliente (QRCode / ICS)"
}

' ---- Integridad referencial ----
TIPO     ||--o{ SALA     : "FK salas.tipo → tipos_sala.id\nCASCADE / RESTRICT"
SALA     ||--o{ RESERVA  : "FK reservas.id_sala → salas.id_sala\nON DELETE CASCADE"
USUARIO  ||..o{ RESERVA  : "FK lógico RUT (cross-DB)"
USUARIO  ||..o{ PENAL    : "FK lógico RUT"
USUARIO  ||..o{ BITACORA : "FK lógico RUT"
SALA     ||--o{ ARCHIVOS : "QR fijo por sala (1:1)"
RESERVA  ||--o{ ARCHIVOS : ".ics por reserva confirmada"

@enduml
