# ==============================================================
# Variables de Entorno — Sistema de Reservas Institucional
# ==============================================================
# INSTRUCCIONES:
# 1. Copia este archivo como .env.local
# 2. Reemplaza los valores con las credenciales reales de Supabase
# 3. NUNCA subas .env.local a Git
#
# REGLA DE ORO:
# - Este proyecto NO usa el cliente Supabase en el navegador.
#   Todas las consultas pasan por rutas API de Next.js con clave secreta.
# - Por eso NO se requiere publishable/anon key.
# - Las claves secret/service_role van SIN prefijo NEXT_PUBLIC_ y solo se
#   usan desde rutas API o módulos marcados con `server-only`.
# ==============================================================

# Secreto para firmar cookies de sesión (HMAC-SHA256). Mínimo 32 caracteres.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia-este-valor-por-uno-aleatorio-de-64-caracteres


# --- DB-Institucional (Supabase Proyecto 1: Padrón / Autenticación) ---
NEXT_PUBLIC_SUPABASE_INSTITUCIONAL_URL=https://TU_PROYECTO_INSTITUCIONAL.supabase.co
# Clave secreta (service role): solo servidor. Omite RLS; nunca en el navegador.
SUPABASE_INSTITUCIONAL_SERVICE_ROLE_KEY=sb_secret_...

# --- DB-Reservas (Supabase Proyecto 2: Lógica de Negocio) ---
NEXT_PUBLIC_SUPABASE_RESERVAS_URL=https://TU_PROYECTO_RESERVAS.supabase.co
# Clave secreta (service role): solo servidor. Omite RLS; nunca en el navegador.
SUPABASE_RESERVAS_SERVICE_ROLE_KEY=sb_secret_...
